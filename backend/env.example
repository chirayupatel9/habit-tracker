# Database Configuration
# Format: mysql+aiomysql://username:password@host:port/database_name
DATABASE_URL=mysql+aiomysql://root:password@localhost:3306/habit_tracker

# JWT Authentication
# Generate a secure secret key: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your-secret-key-change-in-production-use-openssl-rand-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS Origins (comma-separated or JSON array format)
# For development, you can use: ["http://localhost:3000","http://localhost:8000"]
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]

# Email Configuration (Optional - for forgot password functionality)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=

# Firebase Cloud Messaging (Optional - placeholder for future implementation)
FCM_SERVER_KEY=

